@page "/projects/enginecompare"
@inject AppState State
@inject IProjectService ProjectService
@implements IDisposable

<SharedLayout currentProject=ProjectService.GetProjects().ElementAt(0)>
    <TableOfContents>
        <div class="toc-item" onclick="window.scrollToElement('movie-section')">
            @((MarkupString)(State.CurrentLanguage == "PL" ? "Prezentacja wideo (Aquarium)" : "Video Showcase (Aquarium)"))
        </div>
        <div class="toc-item" onclick="window.scrollToElement('movie-section-fox')">
            @((MarkupString)(State.CurrentLanguage == "PL" ? "Prezentacja wideo (Fox)" : "Video Showcase (Fox)"))
        </div>
        <div class="toc-item" onclick="window.scrollToElement('movie-section-map')">
            @((MarkupString)(State.CurrentLanguage == "PL" ? "Prezentacja wideo (Map)" : "Video Showcase (Map)"))
        </div>
        <div class="toc-item" onclick="window.scrollToElement('research-section')">
            @((MarkupString)(State.CurrentLanguage == "PL" ? "Badania i metodologia" : "Research & Methodology"))
        </div>
        <div class="toc-item" onclick="window.scrollToElement('aquarium-results')">
            @((MarkupString)(State.CurrentLanguage == "PL" ? "Wyniki (Akwarium)" : "Results (Aquarium)"))
        </div>
        <div class="toc-item" onclick="window.scrollToElement('fox-results')">
            @((MarkupString)(State.CurrentLanguage == "PL" ? "Wyniki (Lisy)" : "Results (Foxes)"))
        </div>
        <div class="toc-item" onclick="window.scrollToElement('map-results')">
            @((MarkupString)(State.CurrentLanguage == "PL" ? "Wyniki (Mapa)" : "Results (Map)"))
        </div>
        <div class="toc-item" onclick="window.scrollToElement('conclusions')">
            @((MarkupString)(State.CurrentLanguage == "PL" ? "Podsumowanie" : "Summary"))
        </div>
    </TableOfContents>

    <ChildContent>
        <div class="tech-card hide-card" id="movie-section">
            <h3 class="tech-card-title">
                @((MarkupString)(State.CurrentLanguage == "PL" ? "Prezentacja wideo (Aquarium)" : "Video Showcase (Aquarium)"))
            </h3>
            <div class="tech-card-body">
                <div style="text-align: center; margin-bottom: 2rem;">
                    <video controls autoplay loop muted style="max-width: 100%; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
                        <source src="/images/movies/aquarium.webm" type="video/webm" />
                        Twoja przeglądarka nie obsługuje odtwarzacza wideo.
                    </video>
                </div>

                <div class="description-container" style="text-align: left;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h4 style="margin: 0; color: #fff;">@((MarkupString)(State.CurrentLanguage == "PL" ? "Opis sceny" : "Scene Description"))</h4>
                        <div>
                            <button class="version-toggle-btn" @onclick="() => _showLongDescAquarium = !_showLongDescAquarium">
                                @(_showLongDescAquarium ? (State.CurrentLanguage == "PL" ? "Wersja: Pełna" : "Version: Full") : (State.CurrentLanguage == "PL" ? "Wersja: Skrócona" : "Version: Short"))
                            </button>
                        </div>
                    </div>
                    <div class="description-content p-3" style="background-color: rgba(255,255,255,0.05); border-radius: 8px;">
                        @if (!_showLongDescAquarium)
                        {
                            <p style="text-indent: 1.5em; text-align: justify;" class="mb-0">@((MarkupString)(State.CurrentLanguage == "PL" ? "Scenariusz testujący wydajność podsystemów fizyki poprzez symulację swobodnego opadania 11 970 sześcianów do wnętrza modelu „Aquarium”. Celem było wygenerowanie rosnącej liczby jednoczesnych kontaktów i kolizji między obiektami." : "A scenario testing the performance of physics subsystems through the simulation of 11,970 cubes in free fall into the 'Aquarium' model. The goal was to generate an increasing number of simultaneous contacts and collisions."))</p>
                        }
                        else
                        {
                            <p style="text-indent: 1.5em; text-align: justify;" class="mb-0">@((MarkupString)(State.CurrentLanguage == "PL" ? "Pierwszy scenariusz badawczy miał na celu przetestowanie i porównanie wydajności wbudowanych podsystemów fizyki w badanych silnikach. Wykorzystano wbudowane w silniki modele siatki 3D reprezentujące sześciany z nałożonym podstawowym niebieskim materiałem oraz siatką kolizyjną typu pudełkowego. Modelem docelowym był obiekt o nazwie „Aquarium”. Mechanika symulacji opierała się na proceduralnym generowaniu kolejnych, zwartych i prostokątnych warstw sześcianów w regularnych odstępach czasu. Procedura ta była powtarzana przez 19 iteracji, co łącznie dało 11 970 sześcianów. Swobodne opadanie fal obiektów powodowało systematyczne i powtarzalne zwiększanie liczby jednoczesnych kontaktów oraz kolizji, stanowiąc intensywny test dla podsystemu fizyki." : "The first research scenario aimed to test and compare the performance of built-in physics subsystems. Built-in 3D mesh models representing cubes with a basic blue material and box colliders were used. The target model was an object named 'Aquarium'. The simulation mechanics relied on procedural generation of compact, rectangular layers of cubes at regular intervals. This procedure was repeated for 19 iterations, totaling 11,970 cubes. The free fall of successive waves of objects caused a systematic increase in simultaneous collisions, providing an intensive test for the physics engine."))</p>
                        }
                    </div>
                </div>
            </div>
        </div>
        
        <div class="tech-card hide-card" id="movie-section-fox">
            <h3 class="tech-card-title">
                @((MarkupString)(State.CurrentLanguage == "PL" ? "Prezentacja wideo (Fox)" : "Video Showcase (Fox)"))
            </h3>
            <div class="tech-card-body">
                <div style="text-align: center; margin-bottom: 2rem;">
                    <video controls autoplay loop muted style="max-width: 100%; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
                        <source src="/images/movies/fox_compare.webm" type="video/webm" />
                        Twoja przeglądarka nie obsługuje odtwarzacza wideo.
                    </video>
                </div>

                <div class="description-container" style="text-align: left;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h4 style="margin: 0; color: #fff;">@((MarkupString)(State.CurrentLanguage == "PL" ? "Opis sceny" : "Scene Description"))</h4>
                        <div>
                            <button class="version-toggle-btn" @onclick="() => _showLongDescFox = !_showLongDescFox">
                                @(_showLongDescFox ? (State.CurrentLanguage == "PL" ? "Wersja: Pełna" : "Version: Full") : (State.CurrentLanguage == "PL" ? "Wersja: Skrócona" : "Version: Short"))
                            </button>
                        </div>
                    </div>
                    <div class="description-content p-3" style="background-color: rgba(255,255,255,0.05); border-radius: 8px;">
                        @if (!_showLongDescFox)
                        {
                            <p style="text-indent: 1.5em; text-align: justify;" class="mb-0">@((MarkupString)(State.CurrentLanguage == "PL" ? "Test sprawdzający narzut związany z renderowaniem i obsługą animacji szkieletowej dużej liczby poruszających się postaci. W kolejnych cyklach iteracyjnych liczba modeli lisów na scenie była podwajana (od 16 do 1024), poruszając się w kierunku wyznaczonego centrum." : "A test checking the overhead associated with rendering and handling skeletal animation of a large number of moving characters. In successive iterative cycles, the number of fox models on the scene was doubled (from 16 to 1024), moving towards a designated center."))</p>
                        }
                        else
                        {
                            <p style="text-indent: 1.5em; text-align: justify;" class="mb-0">@((MarkupString)(State.CurrentLanguage == "PL" ? "Drugi scenariusz badawczy został zaprojektowany w celu przetestowania wydajności silników pod kątem obciążenia generowanego przez symulację ruchu dużej liczby animowanych obiektów. W roli głównego obiektu wykorzystano niskopoligonowy model lisa z dwoma sekwencjami animacji szkieletowej: chodu oraz spoczynku. Mechanika opierała się na proceduralnym rozmieszczaniu kolejnych fal lisów na obwodzie okręgu, odgórnie zorientowanych frontem do centrum. Logika zachowania oparta na prostej maszynie stanów wymuszała ruch do przodu, a po przekroczeniu granicy strefy następowała zmiana stanu na spoczynek. Test był procesem iteracyjnym, w którym liczba obiektów początkowo wynosiła 16, a w każdym kolejnym z siedmiu cykli była podwajana, skokowo zwiększając obciążenie procesora i układu graficznego." : "The second research scenario was designed to test the engines' performance under the load generated by simulating the movement of a large number of animated objects. A low-poly fox model with two skeletal animation sequences (walk and idle) was used as the main object. The mechanics were based on procedural placement of successive waves of foxes on the circumference of a circle, facing the center. Logic based on a simple state machine forced forward movement until a threshold was crossed. The test was an iterative process where the number of objects doubled in each of the seven cycles, step-wise increasing the <strong>CPU</strong> and <strong>GPU</strong> load."))</p>
                        }
                    </div>
                </div>
            </div>
        </div>
        
        <div class="tech-card hide-card" id="movie-section-map">
            <h3 class="tech-card-title">
                @((MarkupString)(State.CurrentLanguage == "PL" ? "Prezentacja wideo (Map)" : "Video Showcase (Map)"))
            </h3>
            <div class="tech-card-body">
                <div style="text-align: center; margin-bottom: 2rem;">
                    <video controls autoplay loop muted style="max-width: 100%; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
                        <source src="/images/movies/map_compare.webm" type="video/webm" />
                        Twoja przeglądarka nie obsługuje odtwarzacza wideo.
                    </video>
                </div>

                <div class="description-container" style="text-align: left;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h4 style="margin: 0; color: #fff;">@((MarkupString)(State.CurrentLanguage == "PL" ? "Opis sceny" : "Scene Description"))</h4>
                        <div>
                            <button class="version-toggle-btn" @onclick="() => _showLongDescMap = !_showLongDescMap">
                                @(_showLongDescMap ? (State.CurrentLanguage == "PL" ? "Wersja: Pełna" : "Version: Full") : (State.CurrentLanguage == "PL" ? "Wersja: Skrócona" : "Version: Short"))
                            </button>
                        </div>
                    </div>
                    <div class="description-content p-3" style="background-color: rgba(255,255,255,0.05); border-radius: 8px;">
                        @if (!_showLongDescMap)
                        {
                            <p style="text-indent: 1.5em; text-align: justify;" class="mb-0">@((MarkupString)(State.CurrentLanguage == "PL" ? "Złożona scena 3D zróżnicowana pod względem geometrii i materiałów, sprawdzająca ogólną wydajność potoku renderowania. Test polegał na automatycznym przenoszeniu kamery przez sekwencję predefiniowanych, różnorodnych kadrów pomiarowych." : "A complex 3D scene with diverse geometry and materials, testing the overall performance of the rendering pipeline. The test consisted of automatically moving the camera through a sequence of predefined, diverse measurement frames."))</p>
                        }
                        else
                        {
                            <p style="text-indent: 1.5em; text-align: justify;" class="mb-0">@((MarkupString)(State.CurrentLanguage == "PL" ? "Trzeci scenariusz zaprojektowano w celu dokonania oceny wydajności na podstawie złożonej sceny 3D, charakteryzującej się znacznym zróżnicowaniem geometrii oraz materiałów. Podstawę świata stanowił pojedynczy obiekt siatki terenu, do którego zaimportowano zróżnicowany zestaw modeli, w tym elementy architektoniczne, roślinność oraz animowane postaci. Głównym oświetleniem było światło kierunkowe o zasięgu 4000 metrów z nałożonymi cieniami. Przebieg testu realizowano sekwencyjnie poprzez zautomatyzowaną zmianę perspektywy obserwatora na podstawie zdefiniowanej listy punktów kontrolnych reprezentujących różnorodne kadry. Każdy punkt zawierał fazę stabilizacji, w której kamera pozostawała statyczna dla rzetelnego pomiaru." : "The third scenario was designed to evaluate performance based on a complex 3D scene, characterized by significant diversity in geometry and materials. The base of the world was a single terrain mesh object, onto which a diverse set of models was imported, including architectural elements, vegetation, and animated characters. The main lighting was a directional light with a range of 4000 meters and shadows enabled. The test run was executed sequentially through automated camera perspective changes based on a predefined list of waypoints representing various frames. Each point included a stabilization phase where the camera remained static for reliable measurement."))</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="tech-card hide-card" id="research-section">
            <h3 class="tech-card-title">
                @((MarkupString)(State.CurrentLanguage == "PL" ? "Metodologia i cel badań" : "Methodology and Research Goal"))
            </h3>
            <div class="tech-card-body">
                <div class="d-flex justify-content-end mb-3">
                    <button class="version-toggle-btn" @onclick="ToggleDescriptionLength">
                        @(showLongDescription ? (State.CurrentLanguage == "PL" ? "Wersja: Pełna" : "Version: Full") : (State.CurrentLanguage == "PL" ? "Wersja: Skrócona" : "Version: Short"))
                    </button>
                </div>

                @if (!showLongDescription)
                {
                    <p style="text-indent: 1.5em; text-align: justify;">
                        @((MarkupString)(State.CurrentLanguage == "PL" ? "W ramach testów porównano wydajność silników <strong>Godot</strong>, <strong>Unity</strong> i <strong>Unreal</strong> w trzech różnych scenariuszach 3D: symulacji fizyki sześcianów (Akwarium), renderowaniu animowanych postaci (Lisy) oraz złożonej scenie statycznej (Mapa). Mierzono liczbę klatek na sekundę (FPS), stabilność czasu klatki (Frametime), zużycie pamięci <strong>RAM</strong>/<strong>VRAM</strong> oraz czas dodawania obiektów do sceny." : "The tests compared the performance of <strong>Godot</strong>, <strong>Unity</strong>, and <strong>Unreal</strong> engines in three 3D scenarios: cube physics simulation (Aquarium), animated character rendering (Foxes), and a complex static scene (Map). Measurements included frames per second (FPS), frametime stability, <strong>RAM</strong>/<strong>VRAM</strong> usage, and object instantiation time."))
                    </p>
                }
                else
                {
                    <p style="text-indent: 1.5em; text-align: justify;" class="mb-4">
                        @((MarkupString)(State.CurrentLanguage == "PL" ? "Głównym celem badawczym było zweryfikowanie, w jaki sposób odmienne założenia architektoniczne poszczególnych silników (<strong>Godot</strong>, <strong>Unity</strong>, <strong>Unreal</strong>) oraz niskopoziomowe interfejsy programistyczne grafiki (<strong>Vulkan</strong>, <strong>DirectX 12</strong>) wpływają na płynność generowania obrazu, stabilność czasów klatek, wykorzystanie zasobów sprzętowych oraz czas dynamicznego dodawania obiektów." : "The main research goal was to verify how different architectural assumptions of individual engines (<strong>Godot</strong>, <strong>Unity</strong>, <strong>Unreal</strong>) and low-level graphics APIs (<strong>Vulkan</strong>, <strong>DirectX 12</strong>) affect framerate, frametime stability, hardware resource utilization, and dynamic object instantiation time."))
                    </p>

                    <div class="methodology-block mb-5">
                        <h4 style="color: #184592; font-weight: 700; margin-bottom: 20px;">@((MarkupString)(State.CurrentLanguage == "PL" ? "Stanowiska badawcze" : "Test Environments"))</h4>
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped" style="border-collapse: collapse; width: 100%;">
                                <thead style="border-bottom: 2px solid #184592;">
                                    <tr>
                                        <th style="border: 1px solid #dee2e6; padding: 10px;">@((MarkupString)(State.CurrentLanguage == "PL" ? "Parametr" : "Parameter"))</th>
                                        <th style="border: 1px solid #dee2e6; padding: 10px;">@((MarkupString)(State.CurrentLanguage == "PL" ? "Stanowisko A" : "Environment A"))</th>
                                        <th style="border: 1px solid #dee2e6; padding: 10px;">@((MarkupString)(State.CurrentLanguage == "PL" ? "Stanowisko B" : "Environment B"))</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="border: 1px solid #dee2e6; padding: 10px; font-weight: 600;">@((MarkupString)(State.CurrentLanguage == "PL" ? "Procesor" : "Processor"))</td>
                                        <td style="border: 1px solid #dee2e6; padding: 10px;">AMD Ryzen 5 2600<br>6 rdzeni / 12 wątków, 3,4–4,0 GHz<br>19 MB cache</td>
                                        <td style="border: 1px solid #dee2e6; padding: 10px;">Intel Core i5-14600KF<br>14 rdzeni / 20 wątków, 3,5–5,3 GHz<br>24 MB cache</td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #dee2e6; padding: 10px; font-weight: 600;">@((MarkupString)(State.CurrentLanguage == "PL" ? "Karta graficzna" : "Graphics Card"))</td>
                                        <td style="border: 1px solid #dee2e6; padding: 10px;">Palit GeForce RTX 2060 Gaming Pro OC<br>6 GB GDDR6, 1365–1830 MHz, 14000 MHz</td>
                                        <td style="border: 1px solid #dee2e6; padding: 10px;">Gigabyte GeForce RTX 5070 Windforce OC SFF<br>12 GB GDDR7, 2542 MHz, 28000 MHz</td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #dee2e6; padding: 10px; font-weight: 600;">@((MarkupString)(State.CurrentLanguage == "PL" ? "Pamięć RAM" : "RAM"))</td>
                                        <td style="border: 1px solid #dee2e6; padding: 10px;">Corsair Vengeance LPX Black<br>16 GB DDR4 (2 × 8 GB), 2933 MHz, CL16</td>
                                        <td style="border: 1px solid #dee2e6; padding: 10px;">Kingston Fury Beast RGB<br>32 GB DDR5 (2 × 16 GB), 5600 MHz, CL40</td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #dee2e6; padding: 10px; font-weight: 600;">Dysk SATA</td>
                                        <td style="border: 1px solid #dee2e6; padding: 10px;">Crucial MX500<br>TLC, odczyt/zapis: 560/510 MB/s</td>
                                        <td style="border: 1px solid #dee2e6; padding: 10px;">Brak</td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #dee2e6; padding: 10px; font-weight: 600;">Dysk M.2</td>
                                        <td style="border: 1px solid #dee2e6; padding: 10px;">Samsung NVMe 990 EVO Plus<br>TLC, odczyt/zapis: 7150/6300 MB/s</td>
                                        <td style="border: 1px solid #dee2e6; padding: 10px;">GOODRAM NVMe PX500<br>TLC, odczyt/zapis: 2000/1600 MB/s</td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #dee2e6; padding: 10px; font-weight: 600;">@((MarkupString)(State.CurrentLanguage == "PL" ? "Płyta główna" : "Motherboard"))</td>
                                        <td style="border: 1px solid #dee2e6; padding: 10px;">MSI B450 Tomahawk<br>AM4, AMD B450</td>
                                        <td style="border: 1px solid #dee2e6; padding: 10px;">ASUS TUF B760-PLUS Gaming<br>LGA 1700, Intel B760</td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #dee2e6; padding: 10px; font-weight: 600;">@((MarkupString)(State.CurrentLanguage == "PL" ? "System operacyjny" : "Operating System"))</td>
                                        <td style="border: 1px solid #dee2e6; padding: 10px;">Windows 10 Home<br>Aktualizacja skumulowana KB5066747</td>
                                        <td style="border: 1px solid #dee2e6; padding: 10px;">Windows 11 Pro<br>Pakiet Windows Feature Experience 1000.26100.297.0</td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #dee2e6; padding: 10px; font-weight: 600;">@((MarkupString)(State.CurrentLanguage == "PL" ? "Sterownik graficzny" : "Graphics Driver"))</td>
                                        <td style="border: 1px solid #dee2e6; padding: 10px;">NVIDIA GeForce Game Ready 596.49</td>
                                        <td style="border: 1px solid #dee2e6; padding: 10px;">NVIDIA GeForce Game Ready 596.49</td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #dee2e6; padding: 10px; font-weight: 600;">@((MarkupString)(State.CurrentLanguage == "PL" ? "Rozdzielczość" : "Resolution"))</td>
                                        <td style="border: 1px solid #dee2e6; padding: 10px;">2560 × 1440</td>
                                        <td style="border: 1px solid #dee2e6; padding: 10px;">2560 × 1440</td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #dee2e6; padding: 10px; font-weight: 600;">Vulkan SDK</td>
                                        <td style="border: 1px solid #dee2e6; padding: 10px;">1.4.335</td>
                                        <td style="border: 1px solid #dee2e6; padding: 10px;">1.4.350.0</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="methodology-block mb-5">
                        <h4 style="color: #184592; font-weight: 700; margin-bottom: 20px;">@((MarkupString)(State.CurrentLanguage == "PL" ? "Przygotowanie środowiska pomiarowego" : "Measurement Environment Preparation"))</h4>
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div>
                                    <h5 style="color: #111622; font-weight: 600; border-bottom: 1px solid #184592; padding-bottom: 5px; margin-bottom: 15px;">@((MarkupString)(State.CurrentLanguage == "PL" ? "System operacyjny:" : "Operating System:"))</h5>
                                    <ul style="padding-left: 20px;">
                                        <li>@((MarkupString)(State.CurrentLanguage == "PL" ? "Tryb gry: włączony" : "Game Mode: enabled"))</li>
                                        <li>@((MarkupString)(State.CurrentLanguage == "PL" ? "Profil zasilania: Najwyższa wydajność" : "Power profile: Ultimate Performance"))</li>
                                        <li>@((MarkupString)(State.CurrentLanguage == "PL" ? "Priorytet procesu: wysoki (High) dla badanych silników" : "High priority for evaluated engines processes"))</li>
                                        <li>@((MarkupString)(State.CurrentLanguage == "PL" ? "Sprzętowe planowanie GPU (HAGS): aktywne" : "Hardware-Accelerated GPU Scheduling (HAGS): active"))</li>
                                        <li>@((MarkupString)(State.CurrentLanguage == "PL" ? "Aplikacje i usługi w tle: wyłączone" : "Background apps and telemetry: disabled"))</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div>
                                    <h5 style="color: #111622; font-weight: 600; border-bottom: 1px solid #184592; padding-bottom: 5px; margin-bottom: 15px;">@((MarkupString)(State.CurrentLanguage == "PL" ? "Sterownik graficzny:" : "Graphics Driver:"))</h5>
                                    <ul style="padding-left: 20px;">
                                        <li>@((MarkupString)(State.CurrentLanguage == "PL" ? "Tryb zarządzania energią: preferuj maksymalną wydajność" : "Power management mode: prefer maximum performance"))</li>
                                        <li>@((MarkupString)(State.CurrentLanguage == "PL" ? "Filtrowanie tekstur (Jakość): wysoka wydajność" : "Texture filtering quality: high performance"))</li>
                                        <li>@((MarkupString)(State.CurrentLanguage == "PL" ? "Tryb niskiego opóźnienia: wyłączony" : "Low latency mode: off"))</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="methodology-block mb-2">
                        <h4 style="color: #184592; font-weight: 700; margin-bottom: 20px;">@((MarkupString)(State.CurrentLanguage == "PL" ? "Przebieg testów i pomiary:" : "Test Execution and Measurements:"))</h4>
                        <div>
                            <p style=" margin-bottom: 15px; text-indent: 1.5em; text-align: justify;">@((MarkupString)(State.CurrentLanguage == "PL" ? "Pomiary odbywały się wyłącznie w skompilowanych, natywnych wersjach produkcyjnych projektów w celu wyeliminowania narzutu środowiska edytora (ang. editor overhead). Do zbierania telemetrii użyto programu MSI Afterburner z częstotliwością próbkowania 100 ms. Rejestrowano kluczowe metryki:" : "Measurements were conducted exclusively in compiled, native production builds to eliminate editor overhead. Telemetry data was collected using MSI Afterburner with a 100 ms polling rate. Key collected metrics:"))</p>
                            
                            <ul style="margin-bottom: 20px; padding-left: 20px;">
