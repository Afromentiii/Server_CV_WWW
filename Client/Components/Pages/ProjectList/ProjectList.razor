@inject AppState State
@inject NavigationManager Navigation
@inject IProjectService ProjectService
@implements IDisposable

<div class="projects-container">
    <div class="projects-list">
        @foreach (var project in FilteredProjects)
        {
            <div class="project-card" @onclick="() => ChangePage(project.Page)">
                <div class="project-title-section">
                    <h3>@(State.CurrentLanguage == "PL" ? project.TitlePL : project.TitleEN)</h3>
                </div>

                <div class="project-tech-section">
                @foreach (var tech in project.Technologies)
                {
                    @if (State.IconToImgPath.TryGetValue(tech, out var iconPath))
                    {
                        <span class="tech-badge">
                            <img src="@iconPath" alt="@tech" />
                        </span>
                    }
                    else
                    {
                        <span class="tech-badge">@tech</span>
                    }
                }
                </div>
            </div>
        }
        
        @if (!FilteredProjects.Any())
        {
            <div style="text-align:center; padding: 40px; color: #64748b;">
                @(State.CurrentLanguage == "PL" ? "Brak projektów spełniających kryteria." : "No projects match the criteria.")
            </div>
        }
    </div>
</div>

@code {
    private IEnumerable<ProjectModel> FilteredProjects
    {
        get
        {
            var projects = ProjectService.GetProjects();
            if (State.SelectedTechnologies == null || !State.SelectedTechnologies.Any())
            {
                return projects;
            }
            
            return projects.Where(p => State.SelectedTechnologies.All(t => p.Technologies.Contains(t)));
        }
    }

    protected override void OnInitialized()
    {
        State.ToggleFilter();
        State.OnChange += StateHasChanged;
    }
    public void Dispose() => State.OnChange -= StateHasChanged;

    private void ChangePage(string page)
    {
        State.IsShowingFilter = false;
        State.IsFilterMenuOpen = false;
        Navigation.NavigateTo(page);
    }
}