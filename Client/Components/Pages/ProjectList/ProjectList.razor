@inject AppState State
@inject NavigationManager Navigation
@inject List<ProjectModel> ProjectsList
@implements IDisposable

<div class="projects-container">
    <div class="projects-list">
        @foreach (var project in FilteredProjects)
        {
            <div class="project-card" @onclick="() => ChangePage(project.Page)">
                <div class="project-title-section">
                    <h3>@(State.CurrentLanguage == "PL" ? project.TitlePL : project.TitleEN)</h3>
                </div>

                <div class="project-tech-section">
                @foreach (var tech in project.Technologies)
                {
                    @if (iconToImgPath.TryGetValue(tech, out var iconPath))
                    {
                        <span class="tech-badge">
                            <img src="@iconPath" alt="@tech" />
                        </span>
                    }
                    else
                    {
                        <span class="tech-badge">@tech</span>
                    }
                }
                </div>
            </div>
        }
        
        @if (!FilteredProjects.Any())
        {
            <div style="text-align:center; padding: 40px; color: #64748b;">
                @(State.CurrentLanguage == "PL" ? "Brak projektów spełniających kryteria." : "No projects match the criteria.")
            </div>
        }
    </div>
</div>

@code {
    private Dictionary<string, string> iconToImgPath = new ()
    {
        ["Python"] = "images/icons/icons8-python.svg",
        ["Unity"] = "images/icons/icons8-unity.svg",
        ["Unreal"] = "images/icons/icons8-unreal-engine.svg",
        ["Godot"] = "images/icons/icon_color.svg",
        ["C#"] = "images/icons/icons8-c-sharp-logo.svg",
        ["Colab"] = "images/icons/icons8-google-colab.svg",
        ["C++"] = "images/icons/icons8-c.svg",
        ["Java"] = "images/icons/icons8-java.svg",
        ["Neo4j"] = "images/icons/neo4j.svg",
        [".NET"] = "images/icons/icons8-.net-framework.svg",
        ["Html5"] = "images/icons/icons8-html.svg",
        ["Css"] = "images/icons/icons8-css.svg",
    };

    private IEnumerable<ProjectModel> FilteredProjects
    {
        get
        {
            if (State.SelectedTechnologies == null || !State.SelectedTechnologies.Any())
            {
                return ProjectsList;
            }
            
            return ProjectsList.Where(p => State.SelectedTechnologies.All(t => p.Technologies.Contains(t)));
        }
    }

    protected override void OnInitialized()
    {
        State.ToggleFilter();
        State.OnChange += StateHasChanged;
    }
    public void Dispose() => State.OnChange -= StateHasChanged;

    private void ChangePage(string page)
    {
        State.IsShowingFilter = false;
        State.IsFilterMenuOpen = false;
        Navigation.NavigateTo(page);
    }
}