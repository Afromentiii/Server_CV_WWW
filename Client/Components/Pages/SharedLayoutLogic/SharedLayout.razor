@inject AppState State

<div style="display:block; width:100%; align-self: flex-start;">
    <div class="wavy-container">
        <h2 class="wavy-title">
            @(State.CurrentLanguage == "PL" ? currentProject?.TitlePL : currentProject?.TitleEN)
        </h2>
    </div>

    <div class="tech-card @(shouldAnimate ? "animate-card" : "hide-card")">
        <h3 class="tech-card-title">
            @(State.CurrentLanguage == "PL" ? "Cel projektu" : "Project objective")
        </h3>
        <div class="tech-card-body">
            <p>@((MarkupString)(State.CurrentLanguage == "PL" ? currentProject?.ProjectGoalPL : currentProject?.ProjectGoalEN))</p>
        </div>
    </div>
</div>

@code {
    [Parameter] 
    public ProjectModel currentProject { get; set; } = default!;

    private bool shouldAnimate = false;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            shouldAnimate = true;
            StateHasChanged();
        }
    }
}